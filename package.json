{
  "name": "shree-hari-kitchen-mart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "next dev commerce",
    "build": "prisma generate --schema commerce/prisma/schema.prisma && next build commerce",
    "start": "next start commerce",
    "commerce:build": "pnpm build",
    "commerce:start": "pnpm start",
    "commerce:migrate": "prisma migrate deploy --schema commerce/prisma/schema.prisma",
    "commerce:seed": "node --experimental-strip-types commerce/prisma/seed.ts",
    "test": "node --experimental-strip-types --test commerce/tests/rules.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "next": "16.2.6",
    "pdf-lib": "1.17.1",
    "prisma": "6.19.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
