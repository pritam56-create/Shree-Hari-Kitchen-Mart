generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid()) @db.VarChar(30)
  email String @unique @db.VarChar(191)
  phone String? @unique @db.VarChar(20)
  name String @db.VarChar(120)
  passwordHash String @db.VarChar(100)
  disabled Boolean @default(false)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roles UserRole[]
  sessions Session[]
  tokens AuthToken[]
  addresses Address[]
  cart Cart?
  wishlist Wishlist?
  compareList CompareList?
  orders Order[]
  checkouts Checkout[]
  reviews Review[]
  tickets SupportTicket[]
  notifications Notification[]
  couponUsage CouponUsage[]
  audits AuditLog[]
  questions Question[]
  @@map("users")
}
model Role {
  id String @id @db.VarChar(30)
  users UserRole[]
  @@map("roles")
}
model UserRole {
  userId String @db.VarChar(30)
  roleId String @db.VarChar(30)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  role Role @relation(fields:[roleId],references:[id])
  @@id([userId,roleId])
  @@map("user_roles")
}
model Session {
  id String @id @db.VarChar(64)
  userId String @db.VarChar(30)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([expiresAt])
  @@map("sessions")
}
model AuthToken {
  id String @id @db.VarChar(64)
  userId String @db.VarChar(30)
  purpose String @db.VarChar(30)
  expiresAt DateTime
  attempts Int @default(0)
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,purpose])
  @@map("auth_tokens")
}
model RateLimit {
  id String @id @db.VarChar(64)
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
  @@map("rate_limits")
}
model Address {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @db.VarChar(30)
  name String @db.VarChar(120)
  phone String @db.VarChar(20)
  line1 String @db.VarChar(200)
  line2 String @default("") @db.VarChar(200)
  city String @db.VarChar(100)
  state String @db.VarChar(100)
  postalCode String @db.VarChar(10)
  country String @default("IN") @db.Char(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@map("addresses")
}
model Category {
  id String @id @default(cuid()) @db.VarChar(30)
  name String @unique @db.VarChar(120)
  slug String @unique @db.VarChar(191)
  products Product[]
  @@map("categories")
}
model Brand {
  id String @id @default(cuid()) @db.VarChar(30)
  name String @unique @db.VarChar(120)
  slug String @unique @db.VarChar(191)
  products Product[]
  @@map("brands")
}
model Product {
  id String @id @default(cuid()) @db.VarChar(30)
  name String @db.VarChar(180)
  slug String @unique @db.VarChar(191)
  description String @db.Text
  keywords String @default("") @db.VarChar(500)
  categoryId String @db.VarChar(30)
  brandId String @db.VarChar(30)
  warranty String @db.VarChar(200)
  seoTitle String @default("") @db.VarChar(180)
  seoDescription String @default("") @db.VarChar(300)
  active Boolean @default(false)
  vegetarianConfirmed Boolean @default(false)
  contentReviewedBy String? @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category Category @relation(fields:[categoryId],references:[id])
  brand Brand @relation(fields:[brandId],references:[id])
  variants ProductVariant[]
  images ProductImage[]
  specifications ProductSpecification[]
  reviews Review[]
  questions Question[]
  wishlistItems WishlistItem[]
  compareItems CompareItem[]
  @@index([active,categoryId])
  @@index([brandId])
  @@map("products")
}
model ProductVariant {
  id String @id @default(cuid()) @db.VarChar(30)
  productId String @db.VarChar(30)
  sku String @unique @db.VarChar(100)
  name String @db.VarChar(100)
  price Decimal @db.Decimal(12,2)
  mrp Decimal @db.Decimal(12,2)
  gstRate Decimal @default(18) @db.Decimal(5,2)
  capacity String @default("") @db.VarChar(80)
  wattage Int @default(0)
  material String @default("") @db.VarChar(80)
  active Boolean @default(true)
  product Product @relation(fields:[productId],references:[id])
  inventory Inventory[]
  cartItems CartItem[]
  @@map("product_variants")
}
model ProductImage {
  id String @id @default(cuid()) @db.VarChar(30)
  productId String @db.VarChar(30)
  url String @db.VarChar(1000)
  alt String @db.VarChar(250)
  reviewedBy String @db.VarChar(30)
  createdAt DateTime @default(now())
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@map("product_images")
}
model ProductSpecification {
  id String @id @default(cuid()) @db.VarChar(30)
  productId String @db.VarChar(30)
  name String @db.VarChar(100)
  value String @db.VarChar(300)
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@unique([productId,name])
  @@map("product_specifications")
}
model Warehouse {
  id String @id @db.VarChar(30)
  name String @db.VarChar(100)
  inventory Inventory[]
  @@map("warehouses")
}
model Inventory {
  id String @id @default(cuid()) @db.VarChar(30)
  variantId String @db.VarChar(30)
  warehouseId String @db.VarChar(30)
  quantity Int @default(0)
  reserved Int @default(0)
  lowStock Int @default(5)
  updatedAt DateTime @updatedAt
  variant ProductVariant @relation(fields:[variantId],references:[id])
  warehouse Warehouse @relation(fields:[warehouseId],references:[id])
  movements InventoryMovement[]
  reservations Reservation[]
  @@unique([variantId,warehouseId])
  @@map("inventory")
}
model InventoryMovement {
  id String @id @default(cuid()) @db.VarChar(30)
  inventoryId String @db.VarChar(30)
  delta Int
  reason String @db.VarChar(250)
  reference String? @db.VarChar(100)
  actorId String? @db.VarChar(30)
  createdAt DateTime @default(now())
  inventory Inventory @relation(fields:[inventoryId],references:[id])
  @@index([reference])
  @@map("inventory_movements")
}
model Cart {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @unique @db.VarChar(30)
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  items CartItem[]
  @@map("carts")
}
model CartItem {
  id String @id @default(cuid()) @db.VarChar(30)
  cartId String @db.VarChar(30)
  variantId String @db.VarChar(30)
  quantity Int
  saved Boolean @default(false)
  cart Cart @relation(fields:[cartId],references:[id],onDelete:Cascade)
  variant ProductVariant @relation(fields:[variantId],references:[id])
  @@unique([cartId,variantId])
  @@map("cart_items")
}
model Wishlist {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @unique @db.VarChar(30)
  shareToken String? @unique @db.VarChar(64)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  items WishlistItem[]
  @@map("wishlists")
}
model WishlistItem {
  wishlistId String @db.VarChar(30)
  productId String @db.VarChar(30)
  createdAt DateTime @default(now())
  wishlist Wishlist @relation(fields:[wishlistId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id])
  @@id([wishlistId,productId])
  @@map("wishlist_items")
}
model CompareList {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @unique @db.VarChar(30)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  items CompareItem[]
  @@map("compare_lists")
}
model CompareItem {
  compareListId String @db.VarChar(30)
  productId String @db.VarChar(30)
  compareList CompareList @relation(fields:[compareListId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id])
  @@id([compareListId,productId])
  @@map("compare_items")
}
model Coupon {
  id String @id @default(cuid()) @db.VarChar(30)
  code String @unique @db.VarChar(40)
  type String @db.VarChar(10)
  value Decimal @db.Decimal(12,2)
  minimum Decimal @default(0) @db.Decimal(12,2)
  maximum Decimal? @db.Decimal(12,2)
  expiresAt DateTime
  usageLimit Int @default(100)
  perCustomerLimit Int @default(1)
  used Int @default(0)
  active Boolean @default(true)
  restrictions Json
  usage CouponUsage[]
  @@map("coupons")
}
model CouponUsage {
  id String @id @default(cuid()) @db.VarChar(30)
  couponId String @db.VarChar(30)
  userId String @db.VarChar(30)
  orderId String @unique @db.VarChar(30)
  createdAt DateTime @default(now())
  coupon Coupon @relation(fields:[couponId],references:[id])
  user User @relation(fields:[userId],references:[id])
  order Order @relation(fields:[orderId],references:[id])
  @@index([couponId,userId])
  @@map("coupon_usage")
}
model Checkout {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @db.VarChar(30)
  requestKey String @unique @db.VarChar(64)
  gatewayOrderId String? @unique @db.VarChar(100)
  gateway String @db.VarChar(20)
  status String @default("PENDING") @db.VarChar(30)
  snapshot Json
  total Decimal @db.Decimal(12,2)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  order Order?
  attempts PaymentAttempt[]
  reservations Reservation[]
  @@map("checkouts")
}
model Order {
  id String @id @default(cuid()) @db.VarChar(30)
  number String @unique @db.VarChar(40)
  userId String @db.VarChar(30)
  checkoutId String @unique @db.VarChar(30)
  status String @default("PLACED") @db.VarChar(30)
  paymentStatus String @db.VarChar(30)
  paymentMethod String @db.VarChar(40)
  currency String @default("INR") @db.Char(3)
  subtotal Decimal @db.Decimal(12,2)
  discount Decimal @db.Decimal(12,2)
  tax Decimal @db.Decimal(12,2)
  shipping Decimal @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  addressSnapshot Json
  businessSnapshot Json
  stockRestored Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id])
  checkout Checkout @relation(fields:[checkoutId],references:[id])
  items OrderItem[]
  history OrderStatusHistory[]
  payment Payment?
  invoice Invoice?
  shipments Shipment[]
  returns Return[]
  couponUsage CouponUsage?
  @@index([userId,createdAt])
  @@index([status,createdAt])
  @@map("orders")
}
model OrderItem {
  id String @id @default(cuid()) @db.VarChar(30)
  orderId String @db.VarChar(30)
  productId String @db.VarChar(30)
  variantId String @db.VarChar(30)
  name String @db.VarChar(180)
  sku String @db.VarChar(100)
  variant String @db.VarChar(100)
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  discount Decimal @db.Decimal(12,2)
  tax Decimal @db.Decimal(12,2)
  gstRate Decimal @db.Decimal(5,2)
  snapshot Json
  order Order @relation(fields:[orderId],references:[id])
  returnItems ReturnItem[]
  @@index([productId])
  @@map("order_items")
}
model OrderStatusHistory {
  id String @id @default(cuid()) @db.VarChar(30)
  orderId String @db.VarChar(30)
  status String @db.VarChar(30)
  note String @db.VarChar(500)
  actorId String? @db.VarChar(30)
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId],references:[id])
  @@index([orderId,createdAt])
  @@map("order_status_history")
}
model Payment {
  id String @id @default(cuid()) @db.VarChar(30)
  orderId String @unique @db.VarChar(30)
  gateway String @db.VarChar(20)
  gatewayPaymentId String? @unique @db.VarChar(100)
  gatewayOrderId String? @db.VarChar(100)
  amount Decimal @db.Decimal(12,2)
  refunded Decimal @default(0) @db.Decimal(12,2)
  currency String @default("INR") @db.Char(3)
  method String @db.VarChar(40)
  status String @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields:[orderId],references:[id])
  transactions PaymentTransaction[]
  refunds Refund[]
  @@map("payments")
}
model PaymentTransaction {
  id String @id @default(cuid()) @db.VarChar(30)
  paymentId String @db.VarChar(30)
  externalId String @unique @db.VarChar(100)
  kind String @db.VarChar(30)
  amount Decimal @db.Decimal(12,2)
  createdAt DateTime @default(now())
  payment Payment @relation(fields:[paymentId],references:[id])
  @@map("payment_transactions")
}
model PaymentAttempt {
  id String @id @default(cuid()) @db.VarChar(30)
  checkoutId String @db.VarChar(30)
  paymentId String? @db.VarChar(100)
  status String @db.VarChar(30)
  failureReason String? @db.VarChar(500)
  createdAt DateTime @default(now())
  checkout Checkout @relation(fields:[checkoutId],references:[id])
  @@map("payment_attempts")
}
model Invoice {
  id String @id @default(cuid()) @db.VarChar(30)
  orderId String @unique @db.VarChar(30)
  number String @unique @db.VarChar(40)
  snapshot Json
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId],references:[id])
  items InvoiceItem[]
  @@map("invoices")
}
model InvoiceItem {
  id String @id @default(cuid()) @db.VarChar(30)
  invoiceId String @db.VarChar(30)
  snapshot Json
  invoice Invoice @relation(fields:[invoiceId],references:[id])
  @@map("invoice_items")
}
model Sequence {
  id String @id @db.VarChar(30)
  value Int @default(0)
  @@map("sequences")
}
model Shipment {
  id String @id @default(cuid()) @db.VarChar(30)
  orderId String @db.VarChar(30)
  carrier String @db.VarChar(100)
  trackingNumber String @db.VarChar(100)
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId],references:[id])
  tracking ShipmentTracking[]
  @@map("shipments")
}
model ShipmentTracking {
  id String @id @default(cuid()) @db.VarChar(30)
  shipmentId String @db.VarChar(30)
  status String @db.VarChar(30)
  description String @db.VarChar(500)
  createdAt DateTime @default(now())
  shipment Shipment @relation(fields:[shipmentId],references:[id])
  @@map("shipment_tracking")
}
model Review {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @db.VarChar(30)
  productId String @db.VarChar(30)
  rating Int
  title String @db.VarChar(160)
  body String @db.Text
  verified Boolean @default(false)
  status String @default("PENDING") @db.VarChar(20)
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  product Product @relation(fields:[productId],references:[id])
  images ReviewImage[]
  @@unique([userId,productId])
  @@map("reviews")
}
model ReviewImage {
  id String @id @default(cuid()) @db.VarChar(30)
  reviewId String @db.VarChar(30)
  url String @db.VarChar(1000)
  review Review @relation(fields:[reviewId],references:[id],onDelete:Cascade)
  @@map("review_images")
}
model Question {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @db.VarChar(30)
  productId String @db.VarChar(30)
  body String @db.Text
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  product Product @relation(fields:[productId],references:[id])
  answers Answer[]
  @@map("questions")
}
model Answer {
  id String @id @default(cuid()) @db.VarChar(30)
  questionId String @db.VarChar(30)
  body String @db.Text
  actorId String @db.VarChar(30)
  createdAt DateTime @default(now())
  question Question @relation(fields:[questionId],references:[id])
  @@map("answers")
}
model Return {
  id String @id @default(cuid()) @db.VarChar(30)
  orderId String @db.VarChar(30)
  reason String @db.VarChar(500)
  status String @default("REQUESTED") @db.VarChar(30)
  resolution String @default("REFUND") @db.VarChar(30)
  note String @default("") @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields:[orderId],references:[id])
  items ReturnItem[]
  refund Refund?
  @@map("returns")
}
model ReturnItem {
  id String @id @default(cuid()) @db.VarChar(30)
  returnId String @db.VarChar(30)
  orderItemId String @db.VarChar(30)
  quantity Int
  restocked Boolean @default(false)
  return Return @relation(fields:[returnId],references:[id])
  orderItem OrderItem @relation(fields:[orderItemId],references:[id])
  @@unique([returnId,orderItemId])
  @@map("return_items")
}
model Refund {
  id String @id @default(cuid()) @db.VarChar(30)
  returnId String @unique @db.VarChar(30)
  paymentId String @db.VarChar(30)
  gatewayRefundId String? @unique @db.VarChar(100)
  amount Decimal @db.Decimal(12,2)
  status String @default("PENDING") @db.VarChar(30)
  failureReason String? @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  return Return @relation(fields:[returnId],references:[id])
  payment Payment @relation(fields:[paymentId],references:[id])
  @@map("refunds")
}
model SupportTicket {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @db.VarChar(30)
  subject String @db.VarChar(180)
  status String @default("OPEN") @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id])
  messages SupportMessage[]
  @@map("support_tickets")
}
model SupportMessage {
  id String @id @default(cuid()) @db.VarChar(30)
  ticketId String @db.VarChar(30)
  authorId String @db.VarChar(30)
  staff Boolean @default(false)
  body String @db.Text
  createdAt DateTime @default(now())
  ticket SupportTicket @relation(fields:[ticketId],references:[id])
  @@map("support_messages")
}
model Notification {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @db.VarChar(30)
  title String @db.VarChar(180)
  body String @db.Text
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  @@index([userId,createdAt])
  @@map("notifications")
}
model SiteSetting {
  key String @id @db.VarChar(100)
  value Json
  updatedAt DateTime @updatedAt
  @@map("site_settings")
}
model AuditLog {
  id String @id @default(cuid()) @db.VarChar(30)
  actorId String @db.VarChar(30)
  action String @db.VarChar(100)
  entityId String @db.VarChar(100)
  details Json
  createdAt DateTime @default(now())
  actor User @relation(fields:[actorId],references:[id])
  @@index([entityId,createdAt])
  @@map("audit_logs")
}
model Outbox {
  id String @id @default(cuid()) @db.VarChar(30)
  kind String @db.VarChar(30)
  payload Json
  status String @default("PENDING") @db.VarChar(30)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([status,availableAt])
  @@map("outbox")
}
model Reservation {
  id String @id @default(cuid()) @db.VarChar(30)
  checkoutId String @db.VarChar(30)
  inventoryId String @db.VarChar(30)
  quantity Int
  released Boolean @default(false)
  expiresAt DateTime
  checkout Checkout @relation(fields:[checkoutId],references:[id])
  inventory Inventory @relation(fields:[inventoryId],references:[id])
  @@unique([checkoutId,inventoryId])
  @@index([released,expiresAt])
  @@map("inventory_reservations")
}
