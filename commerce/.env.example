# MySQL 8 only. Use a dedicated least-privilege application user.
DATABASE_URL=mysql://app:CHANGE_ME@127.0.0.1:3306/shree_hari
APP_URL=http://localhost:3000
# Provision the initial admin only via this one-time seed configuration.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Use Razorpay test credentials in staging. Never expose the secret to React.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# External notification delivery is disabled unless configured.
RESEND_API_KEY=
MAIL_FROM=
# Architecture slots for later provider adapters; not implemented yet.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
